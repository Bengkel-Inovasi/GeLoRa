APP_HOST=0.0.0.0
APP_PORT=80
APP_ENVIRONMENT=development
APP_LOG_LEVEL=info

CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=true

TOKEN_ISSUER=gelora-api
TOKEN_ACCESS_PRIVATE_KEY=changeme_private_key
TOKEN_ACCESS_TTL_MINUTES=30
TOKEN_REFRESH_PRIVATE_KEY=refresh_private_key
TOKEN_REFRESH_TTL_HOURS=24

MQTT_BROKER_URL=tls://your-cluster-id.s1.eu.hivemq.cloud:8883
MQTT_BROKER_CLIENT_ID=gelora-api
MQTT_BROKER_USERNAME=your_username
MQTT_BROKER_PASSWORD=your_password

SQLITE_DATABASE=./gelora.db
